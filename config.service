[Unit]
Description=transcriptor
After=network.target

[Service]
WorkingDirectory=/home/ngynx/transcriptor/
ExecStart=/home/innova/transcriptor/.venv/bin/python /home/innova/transcriptor/ uvicorn app.main:app --host 0.0.0.0 --port 8000
Restart=always
RestartSec=5
User=root

[Install]
WantedBy=multi-user.target
